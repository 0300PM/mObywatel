# Skopiuj do .env i uzupełnij. Nie udostępniaj pliku .env nikomu.
# Cała konfiguracja dotyczy modelu uruchomionego lokalnie. Nie ma tu kluczy płatnych usług.

# --- Dostawca modelu ---
# ollama: natywne API Ollamy (domyślnie, polski model Bielik)
# zgodny: dowolne API zgodne z OpenAI Chat Completions (vLLM, llama.cpp, LM Studio)
PROVIDER=ollama

# Adres Ollamy. W Dockerze na Linuksie użyj http://host.docker.internal:11434 (patrz docker-compose.yml).
OLLAMA_URL=http://127.0.0.1:11434

# Model asystenta. Pełna nazwa z tagiem jest wymagana, Ollama nie ma tu tagu "latest".
#   SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M   6,7 GB, ok. 12 GB RAM, najlepszy stosunek jakości do pamięci
#   SpeakLeash/bielik-11b-v3.0-instruct:Q8_0     12 GB, ok. 20 GB RAM
#   SpeakLeash/bielik-minitron-7B-v3.0-instruct:Q4_K_M   słabszy, ale szybszy na 8 GB RAM
#   SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0     mały, do testów na słabym sprzęcie
MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M

# Okno kontekstu. Instrukcja systemowa i opisy narzędzi zajmują kilkanaście tysięcy tokenów,
# więc 4096 (domyślne w Ollamie) nie wystarczy. 16384 to bezpieczne minimum, 32768 daje zapas na długą rozmowę.
MODEL_NUM_CTX=16384

# Limit długości jednej odpowiedzi modelu (tokeny) i temperatura (0 = przewidywalnie, 0.2 = naturalnie).
MODEL_MAX_TOKENS=1200
MODEL_TEMPERATURE=0.2

# Czas oczekiwania na odpowiedź modelu (sekundy). Na procesorze pierwsza odpowiedź bywa długa.
MODEL_TIMEOUT=180

# Jak długo model zostaje w pamięci po ostatnim pytaniu (krótszy czas = wolniejsze pierwsze pytanie).
MODEL_KEEP_ALIVE=30m

# 1 = przy starcie serwera wczytaj model do pamięci, żeby pierwsza rozmowa nie czekała na ładowanie wag.
MODEL_WARMUP=1

# --- Wariant PROVIDER=zgodny (vLLM, llama.cpp, LM Studio) ---
# PROVIDER=zgodny
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# MODEL=speakleash/Bielik-11B-v3.0-Instruct
# MODEL_API_KEY=
# W vLLM włącz wybór narzędzi i szablon czatu Bielika:
#   vllm serve speakleash/Bielik-11B-v3.0-Instruct --enable-auto-tool-choice \
#     --tool-call-parser bielik --chat-template ./bielik-tools/tools/bielik_advanced_chat_template.jinja

# --- Serwer ---
HOST=127.0.0.1
PORT=8790
# AGENT_LOG=serwer/agent.log
