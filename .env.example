# Skopiuj do .env. Serwer wczytuje ten plik sam przy starcie.
# Cała konfiguracja dotyczy modelu uruchomionego lokalnie. Nie ma tu kluczy płatnych usług.

# --- Model: wyłącznie Bielik ---
# Projekt obsługuje tylko rodzinę Bielik (SpeakLeash). 1 = inny model jest odrzucany,
# 0 = dopuszczony, ale z ostrzeżeniem (przydatne, gdy chcesz porównać inne modele lokalne).
BIELIK_TYLKO=1

# ollama: natywne API Ollamy (domyślnie)
# zgodny: dowolne API zgodne z OpenAI Chat Completions (vLLM, llama.cpp, LM Studio)
PROVIDER=ollama

# Adres Ollamy. W Dockerze użyj http://host.docker.internal:11434 (patrz docker-compose.yml).
OLLAMA_URL=http://127.0.0.1:11434

# Model asystenta. Pełna nazwa z tagiem jest wymagana, Ollama nie ma tu tagu "latest".
#   SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M   6,7 GB, ok. 12 GB RAM, domyślny
#   SpeakLeash/bielik-11b-v3.0-instruct:Q8_0     12 GB, ok. 20 GB RAM, lepsza jakość
#   SpeakLeash/bielik-minitron-7B-v3.0-instruct:Q4_K_M   słabszy, ale szybszy na 8 GB RAM
#   SpeakLeash/bielik-4.5b-v3.0-instruct:Q8_0     mały, do testów na słabym sprzęcie
MODEL=SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M

# Okno kontekstu. Sama instrukcja systemowa i opisy 66 narzędzi zajmują ok. 14,6 tys. tokenów,
# a do tego dochodzi historia rozmowy. 4096 (domyślne w Ollamie) ucina instrukcję i Bielik
# przestaje wywoływać narzędzia; 16384 wystarcza tylko na ostatnią wymianę zdań.
# 32768 daje ok. 17 tys. tokenów historii (serwer sam przycina starsze tury, gdy się nie mieszczą).
MODEL_NUM_CTX=32768

# Limit długości jednej odpowiedzi (tokeny). Asystent odpowiada w 1–3 zdaniach, więc 1200 wystarcza.
MODEL_MAX_TOKENS=1200

# Próbkowanie dobrane pod Bielika 11B Instruct z wywoływaniem narzędzi: niska temperatura
# stabilizuje wybór funkcji i format JSON, top_p/top_k/min_p obcinają ogon rozkładu,
# a kara powtórzeń trzyma odpowiedzi w jednym języku i bez zapętleń.
MODEL_TEMPERATURE=0.1
MODEL_TOP_P=0.95
MODEL_TOP_K=40
MODEL_MIN_P=0.05
MODEL_REPEAT_PENALTY=1.1
MODEL_REPEAT_LAST_N=256

# Ziarno losowania. -1 = za każdym razem inne (naturalne odpowiedzi), stała liczba = powtarzalne testy.
MODEL_SEED=-1

# Czas oczekiwania na odpowiedź modelu (sekundy). Na procesorze pierwsza odpowiedź bywa długa.
MODEL_TIMEOUT=180

# Jak długo model zostaje w pamięci po ostatnim pytaniu (krótszy czas = wolniejsze pierwsze pytanie).
MODEL_KEEP_ALIVE=30m

# 1 = przy starcie serwera wczytaj model do pamięci, żeby pierwsza rozmowa nie czekała na ładowanie wag.
MODEL_WARMUP=1

# --- Wariant PROVIDER=zgodny (vLLM, llama.cpp, LM Studio) ---
# PROVIDER=zgodny
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# MODEL=speakleash/Bielik-11B-v3.0-Instruct
# MODEL_API_KEY=
# W vLLM włącz wybór narzędzi i szablon czatu Bielika:
#   vllm serve speakleash/Bielik-11B-v3.0-Instruct --enable-auto-tool-choice \
#     --tool-call-parser bielik --chat-template ./bielik-tools/tools/bielik_advanced_chat_template.jinja

# --- Serwer ---
HOST=127.0.0.1
PORT=8790
# AGENT_LOG=serwer/agent.log
