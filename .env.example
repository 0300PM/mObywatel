# Skopiuj do .env. Serwer wczytuje ten plik sam przy starcie.
# Jedyny dostawca modeli: Cloudflare Workers AI. Token zostaje na serwerze, przeglądarka go nie widzi,
# a rozmowa nie idzie z Twojej maszyny. Wszystkie modele z katalogu mieszczą się w darmowym planie
# (10 000 neuronów dziennie, bez karty).

# ---------------------------------------------------------------------------
# 1. Konto i token
# ---------------------------------------------------------------------------
# Account ID: dash.cloudflare.com -> Workers & Pages -> po prawej "Account ID".
# To 32 znaki hex (0-9, a-f) — nie token. Spacje, cudzysłowy i komentarz po wartości są ignorowane,
# a wiersz może zaczynać się od "export".
CLOUDFLARE_ACCOUNT_ID=

# Token: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token -> template
# "Workers AI" (uprawnienie Workers AI: Read). Wklej tutaj.
# NIE wklejaj Global API Key (37 znaków) — Cloudflare nie przyjmuje go w nagłówku Bearer,
# dostaniesz HTTP 401. Token musi być długim ciągiem z sekcji API Tokens.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# 2. Model
# ---------------------------------------------------------------------------
# auto = najszybszy model z katalogu widoczny na Twoim koncie (patrz sekcja 3).
MODEL=auto

# Kolejność wyboru przy MODEL=auto:
#   auto      najszybszy model z katalogu (najmniej neuronów na odpowiedź)
#   szybkosc  to samo co auto
#   jakosc    najpierw modele mocne (gpt-oss-120b, nemotron, kimi), potem reszta
MODEL_PREFERUJ=auto

# 1 = dopuść dowolną nazwę modelu spoza katalogu (odradzane: modele bez wywoływania narzędzi
# albo spoza darmowego planu).
MODELE_DOWOLNE=0

# --- Jakie modele możesz wpisać w MODEL ---
# Cały katalog darmowych modeli Workers AI z wywoływaniem narzędzi. Liczba = przybliżona prędkość,
# a "neurony" rosną z rozmiarem modelu, więc przy dziennym limicie 10 000 lepiej zaczynać od góry listy.
#
#   @cf/ibm-granite/granite-4.0-h-micro             420 tok/s  okno 131k  najmniejszy, najtańszy w neuronach
#   @cf/swiss-ai/apertus-v1.5-8b                    380 tok/s  okno 262k  szybki model otwarty
#   @cf/utter-project/eurollm-9b-it                 340 tok/s  okno  32k  europejski, wielojęzyczny (polski)
#   @cf/openai/gpt-oss-20b                          300 tok/s  okno 131k  mocny w narzędziach, rozsądny koszt
#   @cf/qwen/qwen3-30b-a3b-fp8                      260 tok/s  okno  33k  MoE, dobra polszczyzna
#   @cf/meta/llama-4-scout-17b-16e-instruct         240 tok/s  okno 131k  MoE, duże okno
#   @cf/zai-org/glm-4.7-flash                       210 tok/s  okno 131k  szybki model rozmowny
#   @cf/mistralai/mistral-small-3.1-24b-instruct    190 tok/s  okno 131k  szybki model ogólny
#   @cf/google/gemma-4-26b-a4b-it                   180 tok/s  okno 262k  MoE, dobre instrukcje
#   @cf/openai/gpt-oss-120b                         150 tok/s  okno 131k  najlepsze narzędzia, droższy
#   @cf/nvidia/nemotron-3-120b-a12b                 120 tok/s  okno 262k  wyższa jakość
#   @cf/moonshotai/kimi-k2.6                        100 tok/s  okno 262k  najwyższa jakość, najdroższy
#
# Pełna lista z opisami: python3 serwer/katalog.py
# Modele widoczne na Twoim koncie: curl -s \
#   "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/ai/models/search?per_page=200" \
#   -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" | python3 -m json.tool | grep '"name"'

# ---------------------------------------------------------------------------
# 3. Okno kontekstu i próbkowanie
# ---------------------------------------------------------------------------
# Instrukcja systemowa i opisy 66 narzędzi zajmują ok. 14,6 tys. tokenów, do tego dochodzi historia.
# 32768 daje ok. 17 tys. tokenów historii; serwer sam przycina starsze tury.
MODEL_NUM_CTX=32768

# Limit długości odpowiedzi. Asystent odpowiada w 1–3 zdaniach, a każdy token to neurony.
MODEL_MAX_TOKENS=1200

# Niska temperatura stabilizuje wybór funkcji i format JSON.
MODEL_TEMPERATURE=0.1
MODEL_TOP_P=0.95

# Ziarno losowania: -1 = losowo, stała liczba = powtarzalne odpowiedzi w testach.
MODEL_SEED=-1

# Czas oczekiwania na odpowiedź (sekundy).
MODEL_TIMEOUT=180

# ---------------------------------------------------------------------------
# 4. Serwer
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8790
# Po każdej zmianie tego pliku w Dockerze: docker compose up -d --force-recreate
# (zwykły restart nie czyta .env ponownie). Źródło konfiguracji pokazuje /api/health w polu "config".
# AGENT_LOG=serwer/agent.log
